{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tank Arena server (Node 22)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PORT": "3000" },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
